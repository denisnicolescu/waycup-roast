#MainContent>.shopify-section {
    display: flow-root;

    >section,
    >h1 {
        margin-inline: auto;
        margin-block: 2rem;
        inline-size: min(100% - 6rem, 100rem);
    }

    >section>h2 {
        margin-block-end: 1lh;
    }

    hr {
        margin-block: 1rem;
        border: 0;
        border-top: 1.5px solid var(--color-stone);
    }

    pre:has(code) {
        margin-block: .5rem;
        overflow-x: auto;
        border: .1em dashed var(--color-dark-grey);
        border-radius: .5em;
        font-size: 1.2rem;
        padding: 1.4rem 1.6rem;
        color: var(--color-dark-grey);

        code {
            color: inherit;
        }
    }

    .logos {
        --gap: 1rem;
        --cols: 3;
        --total-gap: calc(var(--gap) * (var(--cols) - 1));
        --item-size-offset: calc(var(--total-gap) / var(--cols));
        --item-size: (100% / var(--cols)) - var(--item-size-offset);

        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: var(--gap);
        padding: 0;

        & li {
            padding: 2rem;
            flex: 0 0 max(18rem, var(--item-size));
            display: flex;
        }

        & svg {
            inline-size: 100%;
            block-size: auto;
        }

        .black path {
            fill: var(--color-black);
        }

        .white {
            background-color: var(--color-dark-grey);
        }

        .white path {
            fill: var(--color-white);
        }
    }

    .colors {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        padding: 0;
        margin-block: 2rem;

        .swatch {
            margin-block-end: .5rem;
            inline-size: 15rem;
            aspect-ratio: 88/60;
            border-radius: .5rem;
            box-shadow: var(--shadow-medium);
        }
    }

    .icons {
        list-style: none;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
        gap: 1rem;
        padding: 0;
        margin-block: 2rem;

        .heading {
            grid-column: 1 / -1;
        }

        .icon {
            /* inline-size: 12rem; */
            display: grid;
            grid-auto-rows: min-content;
            justify-items: stretch;
            align-items: start;
            text-align: center;

            >div {
                aspect-ratio: 1/1;
                display: grid;
                place-items: center;
            }
        }

        & svg {
            inline-size: 3.2rem;
            block-size: auto;
        }
    }

    .dropshadows {
        display: flex;
        flex-wrap: wrap;
        gap: 4rem;
        padding: 4rem;
        background-color: var(--color-soft-blue);

        & li {
            inline-size: 12rem;
            aspect-ratio: 1/1;
            border-radius: 1rem;
            display: grid;
            place-items: center;
            padding: 1rem;
            background-color: var(--color-white);
            text-align: center;
            font-weight: bold;
            color: var(--color-dark-grey);
        }
    }

    .buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        padding: 2rem;

        &.dark {
            background-color: #333333;
        }
    }

    .forms {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin: 20px 0;

        code {
            white-space: pre-wrap;
            word-break: break-word;
        }
    }
}
