{
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cssnano": "^7.0.6",
    "dotenv-webpack": "^8.1.0",
    "glob": "^11.0.0",
    "path": "^0.12.7",
    "postcss": "^8.5.3",
    "postcss-cli": "^11.0.0",
    "postcss-import": "^16.1.0",
    "postcss-preset-env": "^10.1.5",
    "terser-webpack-plugin": "^5.3.10",
    "webpack-cli": "^5.1.4"
  },
  "scripts": {
    "build:postcss": "NODE_ENV=production postcss assets/*.pcss --dir assets --ext dist.css --verbose",
    "watch:postcss": "postcss assets/*.pcss --dir assets --ext dist.css --watch --verbose",
    "build": "npm run build:postcss",
    "watch": "concurrently --kill-others 'npm:watch:postcss'",
    "dev": "(trap 'kill 0' SIGINT; ./start_dev & npm run watch)"
  }
}
