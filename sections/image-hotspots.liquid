{{ 'section-image-hotspots.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-image-hotspots.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign first_active_hotspot = blank

  for i in (1..7)
    assign enabled_key = 'hotspot_' | append: i | append: '_enabled'
    assign hotspot_enabled = section.settings[enabled_key]

    if hotspot_enabled and first_active_hotspot == blank
      assign first_active_hotspot = i
    endif
  endfor

  if first_active_hotspot == blank
    assign first_active_hotspot = 1
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="image-hotspots section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    {% if section.settings.heading != blank or section.settings.description != blank %}
      <div class="image-hotspots__header image-hotspots__header--{{ section.settings.header_alignment }}">
        {% if section.settings.heading != blank %}
          <h2 class="image-hotspots__heading {{ section.settings.heading_size }}">
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="image-hotspots__description rte">
            {{ section.settings.description }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <image-hotspots
      class="image-hotspots__component"
      data-section-id="{{ section.id }}"
      data-active-hotspot="{{ first_active_hotspot }}"
    >
      <div class="image-hotspots__media">
        <div class="image-hotspots__image-wrapper">
          {% if section.settings.image != blank %}
            {{
              section.settings.image
              | image_url: width: 2000
              | image_tag:
                loading: 'lazy',
                widths: '375, 550, 750, 990, 1200, 1500, 2000',
                sizes: '(min-width: 990px) 66vw, 100vw',
                class: 'image-hotspots__image',
                alt: section.settings.image.alt
            }}
          {% else %}
            <div class="image-hotspots__placeholder">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}

          {% for i in (1..7) %}
            {%- liquid
              assign enabled_key = 'hotspot_' | append: i | append: '_enabled'
              assign x_key = 'hotspot_' | append: i | append: '_x'
              assign y_key = 'hotspot_' | append: i | append: '_y'
              assign title_key = 'hotspot_' | append: i | append: '_title'
              assign product_key = 'hotspot_' | append: i | append: '_product'

              assign hotspot_enabled = section.settings[enabled_key]
              assign hotspot_x = section.settings[x_key]
              assign hotspot_y = section.settings[y_key]
              assign hotspot_title = section.settings[title_key]
              assign hotspot_product = section.settings[product_key]
            -%}

            {% if hotspot_enabled %}
              <button
                type="button"
                class="image-hotspots__button{% if i == first_active_hotspot %} is-active{% endif %}"
                style="--hotspot-x: {{ hotspot_x }}%; --hotspot-y: {{ hotspot_y }}%;"
                data-hotspot-trigger="{{ i }}"
                aria-controls="ImageHotspotPanel-{{ section.id }}-{{ i }}"
                aria-expanded="{% if i == first_active_hotspot %}true{% else %}false{% endif %}"
              >
                <span class="image-hotspots__button-number">{{ i }}</span>
                <span class="visually-hidden">
                  {% if hotspot_title != blank %}
                    {{ hotspot_title }}
                  {% elsif hotspot_product != blank %}
                    {{ hotspot_product.title }}
                  {% else %}
                    View hotspot {{ i }}
                  {% endif %}
                </span>
              </button>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      <div class="image-hotspots__content">
        {% for i in (1..7) %}
          {%- liquid
            assign enabled_key = 'hotspot_' | append: i | append: '_enabled'
            assign title_key = 'hotspot_' | append: i | append: '_title'
            assign description_key = 'hotspot_' | append: i | append: '_description'
            assign product_key = 'hotspot_' | append: i | append: '_product'

            assign hotspot_enabled = section.settings[enabled_key]
            assign hotspot_title = section.settings[title_key]
            assign hotspot_description = section.settings[description_key]
            assign hotspot_product = section.settings[product_key]
          -%}

          {% if hotspot_enabled %}
            <div
              id="ImageHotspotPanel-{{ section.id }}-{{ i }}"
              class="image-hotspots__panel{% if i == first_active_hotspot %} is-active{% endif %}"
              data-hotspot-panel="{{ i }}"
              {% unless i == first_active_hotspot %}
                hidden
              {% endunless %}
            >
              <p class="image-hotspots__eyebrow">
                {{ section.settings.hotspot_label | default: 'Hotspot' }}
                {{ i }}
              </p>

              {% if hotspot_title != blank %}
                <h3 class="image-hotspots__title">
                  {{ hotspot_title }}
                </h3>
              {% endif %}

              {% if hotspot_description != blank %}
                <div class="image-hotspots__text rte">
                  {{ hotspot_description }}
                </div>
              {% endif %}

              {% if hotspot_product != blank %}
                <a href="{{ hotspot_product.url }}" class="image-hotspots__product">
                  {% if hotspot_product.featured_image != blank %}
                    <div class="image-hotspots__product-image-wrapper">
                      {{
                        hotspot_product.featured_image
                        | image_url: width: 320
                        | image_tag:
                          loading: 'lazy',
                          widths: '160, 240, 320',
                          sizes: '120px',
                          class: 'image-hotspots__product-image',
                          alt: hotspot_product.featured_image.alt
                      }}
                    </div>
                  {% endif %}

                  <div class="image-hotspots__product-content">
                    <p class="image-hotspots__product-title">
                      {{ hotspot_product.title }}
                    </p>

                    <p class="image-hotspots__product-price">
                      {% if hotspot_product.price_varies %}
                        From {{ hotspot_product.price_min | money }}
                      {% else %}
                        {{ hotspot_product.price | money }}
                      {% endif %}
                    </p>
                  </div>
                </a>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </image-hotspots>
  </div>
</div>

