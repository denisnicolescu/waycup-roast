<div class="pdf-container color-{{ section.settings.color_scheme }}">
  <div class="page-width {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    {% render 'product-pdf-download', product: product, section: section %}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-product.blocks.pdf_download.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.main-product.blocks.pdf_download.settings.heading.label",
      "default": "t:sections.main-product.blocks.pdf_download.settings.heading.default"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:sections.main-product.blocks.pdf_download.settings.heading_tag.label",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h4"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "t:sections.main-product.blocks.pdf_download.settings.show_download_icon.label",
      "default": true
    },
    {
      "type": "textarea",
      "id": "svg_icon",
      "label": "t:sections.main-product.blocks.pdf_download.settings.svg_icon.label",
      "default": "<svg width=\"800px\" height=\"800px\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n<g id=\"Interface / Download\">\n<path id=\"Vector\" d=\"M6 21H18M12 3V17M12 17L17 12M12 17L7 12\" stroke=\"#000000\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n</g>\n</svg>"
    }
  ],
  "presets": [
    { "name": "t:sections.main-product.blocks.pdf_download.name" }
  ]
}
{% endschema %}