{%- liquid
  if content_for_header contains 'section_id'
    assign section_rendering_mode = true
  else
    assign section_rendering_mode = false
  endif
-%}
{%- if section_rendering_mode == false -%}
  {% assign defer_css = 'component-card.css' | asset_url %}
  {% render 'defer-css', url: defer_css %}
  {% assign defer_css = 'component-price.css' | asset_url %}
  {% render 'defer-css', url: defer_css %}
  {% assign defer_css = 'section-related-products.css' | asset_url %}
  {% render 'defer-css', url: defer_css %}
  {% assign defer_css = 'quick-add.css' | asset_url %}
  {% render 'defer-css', url: defer_css %}
  {% assign defer_css = 'component-slider.css' | asset_url %}
  {% render 'defer-css', url: defer_css %}

  {% if section.settings.image_shape == 'blob' %}
    {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
  {%- endif -%}
  <script src="{{ 'quick-add.min.js' | asset_url }}" defer="defer"></script>

  {%- if section.settings.lazy_loading == true -%}
    <lazy-content-loader
      data-url="{{ shop.url }}?section_id={{ section.id }}"
      data-identifier="recently_viewed--loaded"
      data-script="{{ 'component-recently-viewed.min.js' | asset_url }}"
    >
  {%- endif -%}
{%- endif -%}
{%- if section.settings.lazy_loading == false or section_rendering_mode == true -%}
  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}
  <recently-viewed
          class="color-{{ section.settings.color_scheme }} gradient {%unless section.settings.enable_slider%}page-width{% endunless %}{% if section.settings.lazy_loading %} visually-hidden{% endif %}"
          data-section-id="{{ section.id }}"
          data-columns-desktop="{{ section.settings.columns_desktop }}"
          data-columns-mobile="{{ section.settings.columns_mobile }}">

    <div class="page-width section-{{ section.id }}-padding isolate">
      {% if section.settings.heading != blank %}
        <{{ section.settings.heading_tag }} class="recently-viewed__heading center  {{ section.settings.heading_size }}">
          {{ section.settings.heading }}
        </{{ section.settings.heading_tag }}>
      {% endif %}
      <slider-component
        class="
          slider-mobile-gutter
          {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}
        "
      >
        <ul
          id="Slider-{{ section.id }}"
          data-id="{{ section.id }}"
          class="grid product-grid grid--{{ section.settings.columns_desktop }}-col-desktop grid--{{ section.settings.columns_mobile }}-col-tablet-down {% if settings.card_style == 'standard' %} contains-card--standard{% endif %} {% if section.settings.enable_slider %}slider slider--desktop slider--tablet{% endif %}"
          aria-label="{{ 'general.slider.name' | t }}"
        >
          {% # Recently viewed products will be dynamically inserted here %}
        </ul>
        {% if section.settings.enable_slider %}
          <div class="slider-buttons">
            <button
              type="button"
              class="slider-button slider-button--prev"
              name="previous"
              aria-label="{{ 'general.slider.previous_slide' | t }}"
            >
              <span class="svg-wrapper">
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </span>
            </button>
            <button
              type="button"
              class="slider-button slider-button--next"
              name="next"
              aria-label="{{ 'general.slider.next_slide' | t }}"
            >
              <span class="svg-wrapper">
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </span>
            </button>
          </div>
        {% endif %}
      </slider-component>
    </div>
  </recently-viewed>
{%- endif -%}
{%- if section_rendering_mode == false -%}
  </lazy-content-loader>
{%- endif -%}
{%- if section.settings.lazy_loading == false -%}
<script src="{{ 'component-recently-viewed.min.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Recently viewed",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "lazy_loading",
      "label": "Lazy loading",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recently viewed"
    },

    {
      "type": "select",
      "id": "heading_tag",
      "options": [
        {
          "value": "h1",
          "label": "h1"
        },
        {
          "value": "h2",
          "label": "h2"
        },
        {
          "value": "h3",
          "label": "h3"
        },
        {
          "value": "h4",
          "label": "h4"
        },
        {
          "value": "h5",
          "label": "h5"
        },
        {
          "value": "h6",
          "label": "h6"
        }
      ],
      "default": "h2",
      "label": "Heading Tag"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h1",
          "label": "h1"
        },
        {
          "value": "h2",
          "label": "h2"
        },
        {
          "value": "h3",
          "label": "h3"
        },
        {
          "value": "h4",
          "label": "h4"
        },
        {
          "value": "h5",
          "label": "h5"
        },
        {
          "value": "h6",
          "label": "h6"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "t:sections.related-products.settings.columns_desktop.label"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.related-products.settings.image_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.related-products.settings.image_ratio.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.related-products.settings.image_ratio.options__3.label"
        }
      ],
      "default": "square",
      "label": "t:sections.related-products.settings.image_ratio.label"
    },
    {
      "type": "checkbox",
      "id": "enable_slider",
      "default": true,
      "label": "Enable slider"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "2",
      "label": "t:sections.related-products.settings.columns_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "t:sections.related-products.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.related-products.settings.columns_mobile.options__2.label"
        }
      ]
    },

    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Recently viewed"
    }
  ]
}
{% endschema %}
