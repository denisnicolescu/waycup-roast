{% comment %}
  Renders a Pages grid inside the drawer.

  Uses:
  - block.settings.menu_title (fallbacks to menu.title)
  - block.settings.menu (link_list)
  - block.settings.page_limit
  - block.settings.show_titles
  - block.settings.show_excerpts
  - Page image metafield: page.metafields.custom.thumbnail
{% endcomment %}

{% assign menu = block.settings.menu %}

{% if menu.links != blank %}
  <li {{ block.shopify_attributes }}>
    <details id="DrawerDetails-{{ block.id }}">
      <summary
        class="menu-drawer__menu-item list-menu__item link link--text focus-inset"
        id="DrawerSummary-{{ block.id }}"
      >
        {{ block.settings.menu_title | default: menu.title | escape }}
        <span class="svg-wrapper">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
        <span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span>
      </summary>

      <div class="menu-drawer__submenu has-submenu gradient motion-reduce" tabindex="-1">
        <div class="menu-drawer__inner-submenu">
          <button class="menu-drawer__close-button link link--text focus-inset" aria-expanded="true">
            <span class="svg-wrapper">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
            {{ block.settings.menu_title | default: menu.title | escape }}
          </button>

          <ul class="menu-drawer__pages menu-drawer__menu-item grid grid--2-col" role="list">
            {% for link in menu.links limit: block.settings.page_limit %}
              {% if link.type == 'page_link' and link.object %}
                {% assign page_image = link.object.metafields.custom.thumbnail %}
                <li class="menu-drawer__page grid__item">
                  <a href="{{ link.url }}" class="menu-drawer__page-link mega-menu__link">
                    {% if page_image != blank %}
                      {{ page_image | image_url: width: 480 | image_tag:
                        widths: '200,300,480',
                        sizes: '50vw',
                        alt: link.title,
                        class: 'menu-drawer__page-image'
                      }}
                    {% endif %}
                    {% if block.settings.show_titles %}
                      <span class="menu-drawer__page-title">{{ link.title }}</span>
                    {% endif %}
                    {% if block.settings.show_excerpts and link.object.excerpt != blank %}
                      <span class="menu-drawer__page-excerpt">{{ link.object.excerpt | strip_html | truncate: 80 }}</span>
                    {% endif %}
                  </a>
                </li>
              {% endif %}
            {% endfor %}
          </ul>
        </div>
      </div>
    </details>
  </li>
{% endif %}
