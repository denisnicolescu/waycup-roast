<section>
  <h2>Dropshadow</h2>

  <ul class="dropshadows">
    <li style="box-shadow: var(--shadow-small);">Small</li>
    <li style="box-shadow: var(--shadow-medium);">Medium</li>
    <li style="box-shadow: var(--shadow-large);">Large</li>
    <li style="box-shadow: var(--shadow-xlarge);">XLarge</li>
    <li style="box-shadow: var(--shadow-sticky-button);">Sticky Button</li>
  </ul>

  <pre><code>{% raw %}box-shadow: var(--shadow-small);
box-shadow: var(--shadow-medium);
